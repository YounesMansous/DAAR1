digraph automate {
  rankdir=LR;
  node [shape=circle, fontname="Helvetica"];
  edge [fontname="Helvetica"];
  debut [shape=point, width=0];
  q0;
  q1;
  q2;
  q3;
  q4;
  q5 [shape=doublecircle];
  debut -> q0;
  q0 -> q1 [label="G"];
  q1 -> q2 [label="r"];
  q2 -> q2 [label="a, e"];
  q2 -> q3 [label="g"];
  q3 -> q4 [label="AUTRE, G, a, e, g, r"];
  q4 -> q5 [label="r"];
}
