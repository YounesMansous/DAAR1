<?xml version="1.0" encoding="UTF-8"?>
<!--
  Build Ant du clone d'egrep (projet 1, UE DAAR).

  ant            : construit egrep-clone.jar (cible par défaut)
  ant compile    : compile src/ dans bin/
  ant jar        : jar exécutable egrep-clone.jar (sans les tests)
  ant test       : compile tests/ dans bin-tests/, lance TestKmp,
                   puis tests/verifier.sh s'il existe
  ant doc        : Javadoc HTML de src/ dans doc/
  ant clean      : supprime bin/, bin-tests/, doc/ et le jar
  ant bench      : banc de performances (bench/README.md) : CSV dans
                   resultats/, figures dans rapport/figures/
  ant dist       : ant clean jar, puis l'archive de rendu
                   daar-assignment-algorithm-FELLAGUE-MANSOUS.zip
-->
<project name="egrep-clone" default="jar" basedir="."
         xmlns:unless="ant:unless">

    <property name="src.dir"        value="src"/>
    <property name="tests.dir"      value="tests"/>
    <property name="bin.dir"        value="bin"/>
    <property name="bin.tests.dir"  value="bin-tests"/>
    <property name="jar.file"       value="egrep-clone.jar"/>
    <property name="doc.dir"        value="doc"/>
    <property name="bench.dir"      value="bench"/>
    <property name="bin.bench.dir"  value="bin-bench"/>
    <property name="genere.dir"     value="bench/genere"/>
    <property name="dist.nom"
              value="daar-assignment-algorithm-FELLAGUE-MANSOUS"/>
    <property name="rapport.pdf"    value="rapport/rapport.pdf"/>

    <!-- Bytecode Java 11 (version de classe 55) : le jar tourne
         sur n'importe quel Java 11 ou plus -->
    <property name="java.release"   value="11"/>

    <!-- Compile le programme (src/ vers bin/). On repart toujours
         d'un dossier vide : la compilation incrémentale d'Ant ne
         recompile pas les classes qui dépendent d'un fichier modifié,
         et compare les dates à la seconde près. Le projet se compile
         en une seconde environ, donc on ne perd presque rien. -->
    <target name="compile" description="Compile src/ dans bin/">
        <delete dir="${bin.dir}"/>
        <mkdir dir="${bin.dir}"/>
        <javac srcdir="${src.dir}"
               destdir="${bin.dir}"
               encoding="UTF-8"
               release="${java.release}"
               includeantruntime="false"
               debug="true"/>
    </target>

    <!-- Jar exécutable, avec seulement les classes du programme -->
    <target name="jar" depends="compile"
            description="Construit le jar exécutable egrep-clone.jar">
        <jar destfile="${jar.file}">
            <!-- Exclusion de sécurité si des tests ont été
                 compilés à la main dans bin/ -->
            <fileset dir="${bin.dir}" excludes="**/Test*.class"/>
            <manifest>
                <attribute name="Main-Class" value="Main"/>
            </manifest>
        </jar>
    </target>

    <!-- Compile les tests dans un dossier séparé -->
    <target name="compile-tests" depends="compile">
        <delete dir="${bin.tests.dir}"/>
        <mkdir dir="${bin.tests.dir}"/>
        <javac srcdir="${tests.dir}"
               destdir="${bin.tests.dir}"
               encoding="UTF-8"
               release="${java.release}"
               includeantruntime="false"
               debug="true">
            <classpath location="${bin.dir}"/>
        </javac>
    </target>

    <!-- Tests unitaires puis, s'il existe, le script de comparaison
         avec grep -E. Échoue au premier test en échec. -->
    <target name="test" depends="test-kmp, test-verifier"
            description="Lance TestKmp puis tests/verifier.sh s'il existe"/>

    <target name="test-kmp" depends="compile-tests">
        <java classname="TestKmp" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${bin.dir}"/>
                <pathelement location="${bin.tests.dir}"/>
            </classpath>
        </java>
    </target>

    <target name="test-verifier" depends="jar, verifier-present"
            if="verifier.present">
        <exec executable="bash" failonerror="true">
            <arg value="${tests.dir}/verifier.sh"/>
        </exec>
    </target>

    <target name="verifier-present">
        <available file="${tests.dir}/verifier.sh"
                   property="verifier.present"/>
    </target>

    <!-- Javadoc HTML de src/ (classe Main du paquet par défaut
         comprise, d'où le fileset plutôt que packagenames).
         -Xdoclint:all vérifie tous les commentaires, et
         failonwarning fait échouer la cible au moindre
         avertissement. -->
    <target name="doc" description="Génère la Javadoc HTML dans doc/">
        <delete dir="${doc.dir}"/>
        <javadoc destdir="${doc.dir}"
                 encoding="UTF-8"
                 docencoding="UTF-8"
                 charset="UTF-8"
                 windowtitle="egrep-clone"
                 doctitle="egrep-clone : clone d'egrep (projet 1, DAAR)"
                 failonwarning="true"
                 failonerror="true">
            <fileset dir="${src.dir}" includes="**/*.java"/>
            <arg value="--release"/>
            <arg value="${java.release}"/>
            <arg value="-Xdoclint:all"/>
        </javadoc>
    </target>

    <!-- Supprime tout ce qui est produit par le build -->
    <target name="clean"
            description="Supprime bin/, bin-tests/, doc/, bin-bench/ et le jar">
        <delete dir="${bin.dir}"/>
        <delete dir="${bin.tests.dir}"/>
        <delete dir="${doc.dir}"/>
        <delete dir="${bin.bench.dir}"/>
        <delete dir="${genere.dir}"/>
        <delete file="${jar.file}"/>
    </target>

    <!-- Compile le banc de performances dans un dossier séparé -->
    <target name="compile-bench" depends="compile">
        <delete dir="${bin.bench.dir}"/>
        <mkdir dir="${bin.bench.dir}"/>
        <javac srcdir="${bench.dir}"
               destdir="${bin.bench.dir}"
               encoding="UTF-8"
               release="${java.release}"
               includeantruntime="false"
               debug="true">
            <classpath location="${bin.dir}"/>
        </javac>
    </target>

    <!-- Un lancement de Benchmark (une JVM neuve) -->
    <macrodef name="benchmark">
        <attribute name="args"/>
        <sequential>
            <java classname="Benchmark" fork="true" failonerror="true"
                  dir="${basedir}">
                <jvmarg value="-Xmx1g"/>
                <arg line="@{args}"/>
                <classpath>
                    <pathelement location="${bin.dir}"/>
                    <pathelement location="${bin.bench.dir}"/>
                </classpath>
            </java>
        </sequential>
    </macrodef>

    <!-- Banc complet : mesures dans la JVM (Benchmark, une JVM par
         expérience et par algorithme, pour que le JIT d'un algorithme
         ne pèse pas sur les autres), vérification croisée du nombre
         de lignes, puis mesures de bout en bout contre grep
         (bench_bout_en_bout.py, qui exporte une locale UTF-8 pour java
         et grep), puis les figures. Les fichiers générés de 1 à
         32 Mio sont supprimés à la fin. -->
    <target name="bench" depends="jar, compile-bench"
            description="Banc de performances et figures du rapport">
        <delete file="resultats/bench_jvm.csv"/>
        <benchmark args="a kmp"/>
        <benchmark args="a unepasse"/>
        <benchmark args="b naif"/>
        <benchmark args="b unepasse"/>
        <benchmark args="c kmp"/>
        <benchmark args="c unepasse"/>
        <benchmark args="c naif"/>
        <benchmark args="d thompson"/>
        <benchmark args="d naif"/>
        <benchmark args="d unepasse"/>
        <benchmark args="--verifier"/>
        <exec executable="python3" failonerror="true">
            <arg value="${bench.dir}/bench_bout_en_bout.py"/>
        </exec>
        <exec executable="python3" failonerror="true">
            <arg value="${bench.dir}/graphiques.py"/>
        </exec>
        <delete dir="${genere.dir}"/>
    </target>

    <!-- Archive de rendu, avec un dossier racine du même nom. On part
         d'un build propre (clean puis jar) : ni bin*/, ni doc/, ni
         bench/genere/ ne peuvent s'y glisser. Les sources LaTeX du
         rapport n'y sont pas, seulement le PDF et les figures. Si le
         PDF manque, l'archive est faite quand même, avec un
         avertissement. Les scripts .sh restent exécutables (filemode),
         car Ant ne lit pas les droits des fichiers. -->
    <target name="dist" depends="clean, jar"
            description="Archive de rendu ${dist.nom}.zip">
        <available file="${rapport.pdf}" property="rapport.present"/>
        <delete file="${dist.nom}.zip"/>
        <zip destfile="${dist.nom}.zip">
            <zipfileset dir="." prefix="${dist.nom}"
                        excludes="**/*.sh">
                <include name="${jar.file}"/>
                <include name="README.md"/>
                <include name="build.xml"/>
                <include name="Makefile"/>
                <include name="${rapport.pdf}"/>
                <include name="rapport/figures/**"/>
                <include name="${src.dir}/**"/>
                <include name="${tests.dir}/**"/>
                <include name="${bench.dir}/**"/>
                <include name="data/**"/>
                <include name="resultats/**"/>
                <exclude name="${genere.dir}/**"/>
                <exclude name="**/__pycache__/**"/>
                <exclude name="**/*.class"/>
                <exclude name="**/*.aux"/>
                <exclude name="**/*.log"/>
                <exclude name="**/*.out"/>
                <exclude name="**/*.toc"/>
                <exclude name="**/*.synctex.gz"/>
                <exclude name="**/*.fls"/>
                <exclude name="**/*.fdb_latexmk"/>
            </zipfileset>
            <zipfileset dir="." prefix="${dist.nom}" filemode="755">
                <include name="${tests.dir}/*.sh"/>
            </zipfileset>
        </zip>
        <echo level="warning" unless:set="rapport.present">
ATTENTION : ${rapport.pdf} est absent.
L'archive ${dist.nom}.zip a été faite SANS le rapport.
Placez le PDF dans ${rapport.pdf}, puis relancez ant dist.</echo>
    </target>

</project>
